{
  "name": "dsh-port-token",
  "version": "0.1.0",
  "description": "Bottom-right badge for the dsh web GUI that reveals this instance's listen port and remote-access token on one click, and collapses on the next.",
  "license": "MIT",
  "author": "CAOGGL",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "install.ps1",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis"
  ],
  "scripts": {
    "test": "node tools/verify-host.mjs && node tools/verify-browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CAOGGL/dsh-port-token.git"
  },
  "homepage": "https://github.com/CAOGGL/dsh-port-token#readme",
  "bugs": {
    "url": "https://github.com/CAOGGL/dsh-port-token/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
